import Snaky.Game

namespace Snaky.Geometry14

def slice (o : List (Int × Int)) (dx : Nat) : List (List Nat) :=
  (List.range 14).filterMap fun (dy : Nat) =>
    let cells : List (Int × Int) := o.map fun p => (p.1 + (dx : Int), p.2 + (dy : Int))
    if cells.all (fun q => decide (q.1 < (14 : Int) ∧ q.2 < (14 : Int))) then
      some (cells.map fun q => q.2.toNat * 14 + q.1.toNat)
    else none

